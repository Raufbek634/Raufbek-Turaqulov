{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "System administrator or staff member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "phone", "password", "name"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "name": { "type": "string" },
        "group": { "type": "string" },
        "parentPhone": { "type": "string" },
        "birthDate": { "type": "string" },
        "amount": { "type": "number" },
        "createdAt": { "type": "string" },
        "parentChatId": { "type": "number" }
      },
      "required": ["id", "adminId", "name", "amount", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Fee payment record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["id", "adminId", "studentId", "amount", "date"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["id", "adminId", "title", "amount", "date"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Collection of administrators"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of students"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Collection of payments"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Collection of expenses"
    }
  }
}
