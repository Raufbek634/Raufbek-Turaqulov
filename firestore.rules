rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins
    match /admins/{adminId} {
      allow read, write: if true; 
    }

    // Students
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Payments
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read, write: if true;
    }
    
    // Testing path
    match /test/{docId} {
      allow read: if true;
    }
  }
}
